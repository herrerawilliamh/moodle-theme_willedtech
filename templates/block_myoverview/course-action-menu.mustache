{{!
    @template theme_willedtech/block_myoverview/course-action-menu

    Menú ⋮ de la tarjeta. Conserva las acciones de block_myoverview (favorito y «quitar de mi vista», que solo
    afectan a quien mira) y añade un grupo «Gestión del curso» oculto de inicio: theme_willedtech/quickmanage lo
    muestra, enlace a enlace, solo en los cursos donde el servidor confirma el permiso.

    Example context (json):
    {
        "id": 2,
        "uniqid": "abc",
        "fullname": "Curso de ejemplo",
        "isfavourite": false,
        "hidden": false
    }
}}
<div class="ms-auto dropdown">
    <button class="btn btn-icon coursemenubtn aabtn"
        type="button"
        data-bs-toggle="dropdown"
        aria-haspopup="true"
        aria-expanded="false">
        <i class="icon fa fa-ellipsis-v fa-fw m-0" title="{{#str}} aria:courseactions, block_myoverview {{/str}} {{{fullname}}}" aria-hidden="true"></i>
        <span class="visually-hidden">{{#str}} aria:courseactions, block_myoverview {{/str}} {{{fullname}}}</span>
    </button>
    <div class="dropdown-menu dropdown-menu-end wt-coursemenu">
        <h6 class="dropdown-header">{{#str}} menumyview, theme_willedtech {{/str}}</h6>
        <a class="dropdown-item {{#isfavourite}}hidden{{/isfavourite}}" href="#"
            data-action="add-favourite"
            data-course-id="{{id}}"
            aria-controls="favorite-icon-{{ id }}-{{ uniqid }}"
            >
            {{#str}} addtofavourites, block_myoverview {{/str}}
            <div class="visually-hidden">
                {{#str}} aria:addtofavourites, block_myoverview {{/str}} {{{fullname}}}
            </div>
        </a>
        <a class="dropdown-item {{^isfavourite}}hidden{{/isfavourite}}" href="#"
            data-action="remove-favourite"
            data-course-id="{{id}}"
            aria-controls="favorite-icon-{{ id }}-{{ uniqid }}"
            >
            {{#str}} removefromfavourites, block_myoverview {{/str}}
            <div class="visually-hidden">
                {{#str}} aria:removefromfavourites, block_myoverview {{/str}} {{{fullname}}}
            </div>
        </a>
        <a class="dropdown-item {{^hidden}}hidden{{/hidden}}" href="#"
            data-action="show-course"
            data-course-id="{{id}}"
            aria-controls="favorite-icon-{{ id }}-{{ uniqid }}"
            >
            {{#str}} show, block_myoverview {{/str}}
            <div class="visually-hidden">
                {{#str}} aria:showcourse, block_myoverview, {{fullname}} {{/str}}
            </div>
        </a>
        <a class="dropdown-item {{#hidden}}hidden{{/hidden}}" href="#"
            data-action="hide-course"
            data-course-id="{{id}}"
            aria-controls="favorite-icon-{{ id }}-{{ uniqid }}"
            >
            {{#str}} hidecourse, block_myoverview {{/str}}
            <div class="visually-hidden">
                {{#str}} aria:hidecourse, block_myoverview, {{fullname}} {{/str}}
            </div>
        </a>
        <div class="wt-coursemenu-manage d-none" data-region="wt-manage-menu">
            <div class="dropdown-divider"></div>
            <h6 class="dropdown-header">{{#str}} menumanage, theme_willedtech {{/str}}</h6>
            <a class="dropdown-item d-none" href="#" data-action="wt-toggle-visibility" data-course-id="{{id}}"
                data-wt-cap="visibility">
                <i class="icon fa fa-eye-slash fa-fw" aria-hidden="true" data-region="wt-vis-icon"></i>
                <span data-region="wt-vis-label">{{#str}} hidefromstudents, theme_willedtech {{/str}}</span>
            </a>
            <a class="dropdown-item d-none" href="{{config.wwwroot}}/course/edit.php?id={{id}}" data-wt-cap="update">
                <i class="icon fa fa-cog fa-fw" aria-hidden="true"></i>{{#str}} editsettings, core {{/str}}
            </a>
            <a class="dropdown-item d-none" href="{{config.wwwroot}}/user/index.php?id={{id}}" data-wt-cap="participants">
                <i class="icon fa fa-users fa-fw" aria-hidden="true"></i>{{#str}} participants, core {{/str}}
            </a>
        </div>
    </div>
</div>
