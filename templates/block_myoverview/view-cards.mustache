{{!
    @template theme_willedtech/block_myoverview/view-cards

    Vista de tarjetas de «Vista general del curso». Mismo contrato que block_myoverview/view-cards; cambia solo
    los envoltorios del menú y del progreso (la tarjeta de Campus los coloca en una fila compacta) y carga la
    gestión rápida (theme_willedtech/quickmanage), que pide al servidor qué cursos puede gestionar el usuario.

    Example context (json):
    {
        "courses": [
            {
                "name": "Assignment due 1",
                "viewurl": "https://moodlesite/course/view.php?id=2",
                "courseimageurl": "https://moodlesite/theme/image.php/boost/core/1523325128/f/text",
                "fullname": "course 3",
                "hasprogress": true,
                "progress": 10,
                "visible": true
            }
        ]
    }
}}
{{< core_course/coursecards }}
    {{$menu}}
        <div class="menu wt-coursecard-menu">
            {{> block_myoverview/course-action-menu }}
        </div>
    {{/menu}}
    {{$progress}}
        {{#hasprogress}}
            <div class="wt-coursecard-progress w-100">
                {{> block_myoverview/progress-bar}}
            </div>
        {{/hasprogress}}
    {{/progress}}
    {{$coursename}}
        <span class="multiline" title="{{fullname}}">
            <span class="visually-hidden">{{{fullname}}}</span>
            <span aria-hidden="true">
                {{#shortentext}}55, {{{fullname}}} {{/shortentext}}
            </span>
        </span>
    {{/coursename}}
    {{$coursecategory}}
        {{#showcoursecategory}}
            <span class="visually-hidden">
                {{#str}}aria:coursecategory, core_course{{/str}}
            </span>
            <span class="categoryname text-truncate">
                {{{coursecategory}}}
            </span>
        {{/showcoursecategory}}
    {{/coursecategory}}
{{/ core_course/coursecards }}
{{#js}}
require(['theme_willedtech/quickmanage'], function(QuickManage) {
    QuickManage.init();
});
{{/js}}
