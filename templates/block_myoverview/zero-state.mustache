{{!
    @template theme_willedtech/block_myoverview/zero-state

    Estado vacío de «Vista general del curso»: mensaje claro y acceso al catálogo.
    Mantiene el contrato del original (nocoursesimg, title, intro, buttons).

    Example context (json):
    {
        "nocoursesimg": "https://moodle.org/img/nocourses.svg",
        "title": "No courses",
        "intro": "Come back later",
        "buttons": [
            {"id": "buttons1", "method": "get", "url": "#", "primary": true, "label": "Button1"}
        ]
    }
}}
<div class="block-myoverview block-cards wt-zerostate" data-region="myoverview">
    <div class="container-fluid p-0">
        <div class="text-center py-4" data-region="empty-message">
            <img class="empty-placeholder-image-lg mt-1" src="{{nocoursesimg}}" alt="">
            <h4 class="h4 mt-3 mb-0">{{{ title }}}</h4>
            <p class="mt-3 mb-0">{{{ intro }}}</p>
            <div class="mt-4 mb-0 whitebutton" id="action_bar">
                {{#buttons}}
                    {{>core/single_button}}
                {{/buttons}}
            </div>
        </div>
    </div>
</div>
