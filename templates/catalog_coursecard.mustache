{{!
    @template theme_willedtech/catalog_coursecard

    Tarjeta de curso del catálogo (/course/index.php y búsqueda). Todo el contenido llega ya
    formateado y saneado por core_course_renderer; aquí solo se compone.

    Example context (json):
    {
        "id": 2,
        "classes": "odd first",
        "viewurl": "https://moodlesite/course/view.php?id=2",
        "fullname": "Curso de ejemplo",
        "dimmed": false,
        "hasimage": true,
        "imageurl": "https://moodlesite/pluginfile/1/course/overviewfiles/a.jpg",
        "name": "<h3 class=\"coursename\"><a class=\"aalink\" href=\"#\">Curso</a></h3>",
        "enrolmenticons": "",
        "content": "<div class=\"summary\">Resumen</div>"
    }
}}
<div class="card wt-catalog-card {{classes}}" data-courseid="{{id}}" data-type="1">
    {{#hasimage}}
    <a href="{{viewurl}}" tabindex="-1" aria-hidden="true" class="wt-coursecard-cover-link">
        <div class="card-img-top wt-coursecard-cover" style='background-image: url("{{imageurl}}");'></div>
    </a>
    {{/hasimage}}
    {{^hasimage}}
    <div class="card-img-top wt-coursecard-cover wt-coursecard-cover-empty" aria-hidden="true"></div>
    {{/hasimage}}
    <div class="card-body">
        <div class="info">
            {{{name}}}
            {{{enrolmenticons}}}
        </div>
        <div class="content">
            {{{content}}}
        </div>
    </div>
    <div class="wt-coursecard-action">
        <a href="{{viewurl}}" class="btn btn-sm btn-primary">
            {{#str}} viewcourse, theme_willedtech {{/str}}
            <span class="visually-hidden">: {{fullname}}</span>
        </a>
    </div>
</div>
