{{!
    @template theme_willedtech/dashboard_hero

    Encabezado académico del Área personal. Solo muestra datos reales del usuario y enlaces según sus permisos.

    Example context (json):
    {
        "firstname": "Ana",
        "hascourses": true,
        "coursecount": 3,
        "catalogurl": "https://moodlesite/course/index.php",
        "calendarurl": "https://moodlesite/calendar/view.php?view=upcoming",
        "isteacher": true,
        "teaches": true,
        "teachercourses": 3,
        "teacherstudents": 30,
        "grading": {"has": true, "total": 17, "activities": 3, "oldestdays": 5, "hasolddays": true, "url": "#"},
        "cancreate": true,
        "createurl": "https://moodlesite/course/edit.php?category=1",
        "canmanage": true,
        "manageurl": "https://moodlesite/course/management.php"
    }
}}
<section class="wt-hero{{#teaches}} wt-hero-teacher{{/teaches}}" aria-labelledby="wt-hero-title">
    <div class="wt-hero-main">
        <div class="wt-hero-text">
            <p class="wt-hero-eyebrow">{{#isteacher}}{{#str}} heroteacher, theme_willedtech {{/str}}{{/isteacher}}{{^isteacher}}{{#str}} herostudent, theme_willedtech {{/str}}{{/isteacher}}</p>
            <h2 id="wt-hero-title" class="wt-hero-title">{{#str}} herowelcome, theme_willedtech, {{firstname}} {{/str}}</h2>
            <p class="wt-hero-lead">
                {{#teaches}}{{#str}} teacher_lead, theme_willedtech, { "courses": {{teachercourses}}, "students": {{teacherstudents}} } {{/str}}{{/teaches}}
                {{^teaches}}
                    {{#hasstudentdue}}{{#str}} student_lead, theme_willedtech, { "due": {{studentdue}}, "courses": {{coursecount}} } {{/str}}{{/hasstudentdue}}
                    {{^hasstudentdue}}{{#hascourses}}{{#str}} herocourses, theme_willedtech, {{coursecount}} {{/str}}{{/hascourses}}{{/hasstudentdue}}
                    {{^hascourses}}{{#str}} heronocourses, theme_willedtech {{/str}}{{/hascourses}}
                {{/teaches}}
            </p>
        </div>
        <nav class="wt-hero-actions" aria-label="{{#str}} heroactions, theme_willedtech {{/str}}">
            {{^teaches}}{{#hascourses}}<a class="btn btn-primary" href="#region-main">{{#str}} herogocourses, theme_willedtech {{/str}}</a>{{/hascourses}}{{/teaches}}
            {{#cancreate}}<a class="btn btn-outline-secondary wt-hero-create" href="{{createurl}}">{{#str}} herocreate, theme_willedtech {{/str}}</a>{{/cancreate}}
            {{#canmanage}}<a class="btn btn-outline-secondary wt-hero-manage" href="{{manageurl}}">{{#str}} heromanage, theme_willedtech {{/str}}</a>{{/canmanage}}
            <a class="btn btn-outline-secondary" href="{{calendarurl}}">{{#str}} heroagenda, theme_willedtech {{/str}}</a>
            <a class="btn {{#hascourses}}btn-outline-secondary{{/hascourses}}{{^hascourses}}btn-primary{{/hascourses}}" href="{{catalogurl}}">{{#str}} herocatalog, theme_willedtech {{/str}}</a>
        </nav>
    </div>
    {{#teaches}}
    {{#grading}}
    <div class="wt-hero-grading">
        <p class="wt-hero-grading-label">{{#str}} teacher_tograde, theme_willedtech {{/str}}</p>
        {{#has}}
            <p class="wt-hero-grading-figure">
                <span class="wt-hero-grading-num">{{total}}</span>
                <span>{{#str}} teacher_submissionsin, theme_willedtech, {{activities}} {{/str}}</span>
            </p>
            {{#hasolddays}}<p class="wt-hero-grading-note">{{#str}} teacher_oldest, theme_willedtech, {{oldestdays}} {{/str}}</p>{{/hasolddays}}
            <a class="btn wt-btn-highlight" href="{{url}}">{{#str}} teacher_startgrading, theme_willedtech {{/str}}</a>
        {{/has}}
        {{^has}}
            <p class="wt-hero-grading-figure"><span class="wt-hero-grading-num">0</span></p>
            <p class="wt-hero-grading-note">{{#str}} teacher_nothing, theme_willedtech {{/str}}</p>
        {{/has}}
    </div>
    {{/grading}}
    {{/teaches}}
</section>
